# MX SaudeVida — variaveis de ambiente
# Copie para apps/web/.env.local (app) ou .env (scripts) e preencha.
# Nenhuma chave real entra no repositorio — e este repositorio e publico.

# ---------------------------------------------------------------------------
# Supabase — UM projeto (decisao de 28/09/2026): producao e o palco de ensaio
# ate o go-live, com base sintetica; `ensaio_zerar()` limpa antes da carga real.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# A chave secreta (sb_secret_...) IGNORA a RLS. Vive so no servidor: nunca em
# NEXT_PUBLIC_*, nunca em componente de cliente.
SUPABASE_SECRET_KEY=

# Conexao direta — usada pelo teste de RLS e pelas migrations.
SUPABASE_DB_URL=postgresql://postgres:senha@localhost:54322/postgres

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
# Base publica, usada nos links das mensagens e no callback de senha.
NEXT_PUBLIC_URL_BASE=http://localhost:3000

# ---------------------------------------------------------------------------
# IA — leitura do PDF da apolice (Sprint 1)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Cotacao do dolar para registrar o custo em real em ai_runs.
AI_USD_BRL=5.50

# ---------------------------------------------------------------------------
# Cron diario do Controle (Sprint 2). A rota confere este segredo; sem ele,
# qualquer pessoa dispararia os e-mails do dia.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# E-mail transacional
# ---------------------------------------------------------------------------
# As mensagens do mes (informar ate, corte, boleto, vencimento) e — pelo gancho
# do Supabase — a recuperacao de senha. SEM estas variaveis o sistema NAO
# quebra: a tela avisa que o envio nao esta configurado.
#
# Quem decide o provedor e lib/email/provedor.ts: Microsoft Graph completo
# ganha; senao Resend; senao nada.
#
# Graph: registro de aplicativo no Entra ID com permissao de APLICATIVO
# Mail.Send, consentimento do administrador, um segredo de cliente, e uma
# Application Access Policy restringindo o aplicativo a caixa de sistemas.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# A PROPRIA caixa, com o nome junto:  MX SaudeVida <caixa@dominio.com.br>
EMAIL_REMETENTE=
# Para onde o cliente responde. Sem isto, a resposta vai para a caixa de sistemas.
EMAIL_RESPONDER_PARA=

# Gancho "Send Email" do Supabase (Authentication > Hooks): chama
# POST /api/auth/email. Formato v1,whsec_... Sem ele a rota devolve 503.
SUPABASE_AUTH_HOOK_SECRET=

# Alternativa, so quando o Graph acima nao esta completo (exige dominio
# verificado — SPF e DKIM no DNS):
RESEND_API_KEY=
